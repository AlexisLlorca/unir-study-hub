# =====================================================================
# UNIR STUDY HUB — VARIABLES DE ENTORNO Y CONFIGURACIÓN
# =====================================================================

# 1. URL base del Campus Virtual de la UNIR
UNIR_CAMPUS_URL=https://campusvirtual.unir.net/

# 2. Clave de API de Google Gemini (Para el Asistente de IA, resúmenes y exámenes)
# Consigue tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. Modelo preferido de IA (Recomendado: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 4. Acceso y administración
# Token que abre la puerta de la red (móvil, tablet...). NO es una contraseña.
HUB_ACCESS_TOKEN=
HUB_ADMIN_USER=alexking44
# Contraseña real del administrador. Si se deja vacía y la cuenta no existe,
# se genera una aleatoria y se muestra una vez en el log.
HUB_ADMIN_PASSWORD=
# IPs de proxies de confianza (separadas por comas) para aceptar X-Forwarded-For.
# En local no hace falta; en la nube (Render/HF) pon aquí la IP del proxy.
HUB_TRUSTED_PROXIES=

# 5. Sincronización con Hugging Face
HF_TOKEN=
HF_DATASET_REPO=
